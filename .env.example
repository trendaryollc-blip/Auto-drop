PINTEREST_CLIENT_SECRET=REPLACE_WITH_YOUR_KEY


# ── BACKEND / INFRASTRUCTURE ──────────────────────────────────────

BACKEND_URL=http://localhost:3001/api
TRENDARYO_API_KEY=REPLACE_WITH_YOUR_KEY
TRENDARYO_STORE_URL=https://trendaryo.com


# ── BACKEND SERVER SETTINGS ───────────────────────────────────────
# These go in backend/.env

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DB_ADAPTER=firestore
FIREBASE_PROJECT_ID=REPLACE_WITH_YOUR_KEY
FIREBASE_PRIVATE_KEY=REPLACE_WITH_YOUR_KEY
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_YOUR_KEY
FIREBASE_SERVICE_ACCOUNT_PATH=
JWT_SECRET=REPLACE_WITH_YOUR_KEY
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
