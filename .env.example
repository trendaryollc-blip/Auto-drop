# ===================================================================
# HuntDrop AI — Environment Variables Example
# Copy this file to .env and replace "REPLACE_WITH_YOUR_KEY" with actual keys.
# ===================================================================


# ── AI PROVIDER API KEYS ───────────────────────────────────────────
# Default provider: Groq (free tier). At minimum, set one AI key.

OPENAI_API_KEY=REPLACE_WITH_YOUR_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_KEY
GOOGLE_AI_API_KEY=REPLACE_WITH_YOUR_KEY
GROQ_API_KEY=REPLACE_WITH_YOUR_KEY
DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_KEY
MISTRAL_API_KEY=REPLACE_WITH_YOUR_KEY
COHERE_API_KEY=REPLACE_WITH_YOUR_KEY
TOGETHER_API_KEY=REPLACE_WITH_YOUR_KEY
HUGGINGFACE_API_KEY=REPLACE_WITH_YOUR_KEY
PERPLEXITY_API_KEY=REPLACE_WITH_YOUR_KEY
FIREWORKS_API_KEY=REPLACE_WITH_YOUR_KEY
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_KEY
REPLICATE_API_KEY=REPLACE_WITH_YOUR_KEY
OCTOAI_API_KEY=REPLACE_WITH_YOUR_KEY
LEPTON_API_KEY=REPLACE_WITH_YOUR_KEY


