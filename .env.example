# HuntDrop AI — Environment Variables
# Copy this file to .env and fill in your values.

# AI Provider API Keys (used by AI Analyst, AI Coach, Ad Studio, etc.)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Optional: Custom API endpoints
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: Web Search API
# SERP_API_KEY=
# BRAVE_SEARCH_API_KEY=

# Debug mode (set to "true" to enable console logging)
# HUNTDROP_DEBUG=false

# ===== Backend Configuration =====
# The backend runs separately. Copy backend/.env.example to backend/.env
# and configure the following:

# Frontend → Backend connection (set in the frontend or as a global)
# BACKEND_URL=http://localhost:3001/api

# Backend server settings (in backend/.env):
# PORT=3001
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173
# DB_ADAPTER=firestore
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# JWT_SECRET=change-this-to-a-random-64-char-string
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
