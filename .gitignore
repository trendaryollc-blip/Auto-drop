# ===================================================================
# HuntDrop AI — Git Ignore
# ===================================================================

# ── Environment & Secrets ──────────────────────────────────────────
.env
.env.*
!.env.example
!.env.example.*
env-config.js

# ── Dependencies ───────────────────────────────────────────────────
node_modules/
backend/node_modules/

# ── Build Output ───────────────────────────────────────────────────
dist/
build/

# ── Logs ───────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── OS Files ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── IDE / Editor ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Firebase / Service Accounts ────────────────────────────────────
backend/serviceAccountKey.json
backend/**/serviceAccountKey.json
*-service-account.json
*-firebase-adminsdk-*.json

# ── Coverage / Test ────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ───────────────────────────────────────────────────────────
*.pem
*.key
.cache/
.parcel-cache/
