{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "echo 'Static site'",
      "installCommand": "echo 'No install needed'"
    },
    "backend": {
      "root": "backend"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
